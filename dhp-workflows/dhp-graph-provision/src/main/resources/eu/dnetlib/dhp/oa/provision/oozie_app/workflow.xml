<workflow-app name="index_infospace_graph" xmlns="uri:oozie:workflow:0.5">

    <parameters>
        <property>
            <name>inputType</name>
            <description>hdfs path or DB</description>
        </property>
        <property>
            <name>inputGraph</name>
            <description>root location of input materialized graph</description>
        </property>
        <property>
            <name>isLookupUrl</name>
            <description>URL for the isLookup service</description>
        </property>
        <property>
            <name>contextApiBaseUrl</name>
            <description>context API URL</description>
        </property>
        <property>
            <name>zkHost</name>
            <description>Solr cluster Zookeeper URLs</description>
        </property>
        <property>
            <name>validateXML</name>
            <value>false</value>
            <description>should the payload converter validate the XMLs</description>
        </property>
        <property>
            <name>relPartitions</name>
            <description>number or partitions for the relations Dataset</description>
        </property>
        <property>
            <name>relationFilter</name>
            <description>filter applied reading relations (by relClass)</description>
        </property>
        <property>
            <name>sourceMaxRelations</name>
            <description>maximum number of relations allowed for a each entity grouping by source</description>
        </property>
        <property>
            <name>targetMaxRelations</name>
            <description>maximum number of relations allowed for a each entity grouping by target</description>
        </property>
        <property>
            <name>collection</name>
            <value>shadow</value>
            <description>collection name, indexing target</description>
        </property>
        <property>
            <name>batchSize</name>
            <description>number of records to be included in each indexing request</description>
        </property>
        <property>
            <name>solrDeletionQuery</name>
            <value>*:*</value>
            <description>query used in the deleted by query operation</description>
        </property>
        <property>
            <name>shouldFilterXmlPayload</name>
            <value>false</value>
            <description>activates filtering of the XML payloads</description>
        </property>

        <property>
            <name>JAVA_HOME</name>
            <value>/srv/java/openjdk-17</value>
            <description>Used to configure the Java home location</description>
        </property>
        <property>
            <name>sparkClusterOpts</name>
            <value>--conf spark.extraListeners= --conf spark.sql.queryExecutionListeners= --conf spark.yarn.historyServer.address=http://iis-cdh5-test-gw.ocean.icm.edu.pl:18089 --conf spark.executorEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.yarn.appMasterEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.yarn.appMasterEnv.HADOOP_USER_NAME=dnet.beta --conf spark.sql.warehouse.dir=/user/hive/warehouse --conf spark.oozie.action.sharelib.for.spark=spark344 --conf spark.eventLog.compression.codec=lz4 --conf spark.shuffle.mapStatus.compression.codec=lz4 --conf spark.shuffle.useOldFetchProtocol=true --conf spark.network.maxRemoteBlockSizeFetchToMem=1G --conf spark.eventLog.enabled=true --conf spark.eventLog.dir=hdfs://nameservice1/user/spark/spark2ApplicationHistory</value>
            <description>spark cluster-wide options</description>
        </property>
        <property>
            <name>sparkResourceOpts</name>
            <value>--executor-memory=8G --conf spark.executor.memoryOverhead=6G --executor-cores=4 --driver-memory=9G --driver-cores=4 --conf spark.default.parallelism=3840 --conf spark.sql.shuffle.partitions=7680 --conf spark.sql.files.maxPartitionBytes=33554432 --conf spark.sql.adaptive.advisoryPartitionSizeInBytes=32m --conf spark.sql.adaptive.coalescePartitions.parallelismFirst=false --conf spark.sql.adaptive.forceOptimizeSkewedJoin=true --conf spark.sql.adaptive.skewJoin.skewedPartitionThresholdInBytes=64m --conf spark.sql.adaptive.skewJoin.skewedPartitionFactor=3.0 --conf spark.executor.extraJavaOptions="-XX:MaxDirectMemorySize=4g" --conf spark.sql.parquet.enableVectorizedReader=false --conf spark.kryoserializer.buffer.max=128m</value>
            <description>spark resource options</description>
        </property>
        <property>
            <name>sparkResourceOptsForIndexing</name>
            <value>--executor-memory=2G --conf spark.executor.memoryOverhead=1G --driver-memory=8G --driver-cores=4 --conf spark.driver.memoryOverhead=4G --conf spark.dynamicAllocation.maxExecutors=64 --conf spark.dynamicAllocation.enabled=true</value>
            <description>spark resource options</description>
        </property>
    </parameters>

    <global>
        <job-tracker>${jobTracker}</job-tracker>
        <name-node>${nameNode}</name-node>
        <configuration>
            <property>
                <name>oozie.launcher.mapreduce.map.env</name>
                <value>JAVA_HOME=${JAVA_HOME}</value>
            </property>
            <property>
                <name>oozie.launcher.mapreduce.user.classpath.first</name>
                <value>true</value>
            </property>
        </configuration>
    </global>

    <start to="resume_from"/>

    <decision name="resume_from">
        <switch>
            <case to="prepare_relations">${wf:conf('resumeFrom') eq 'prepare_relations'}</case>
            <case to="fork_join_related_entities">${wf:conf('resumeFrom') eq 'fork_join_related_entities'}</case>
            <case to="fork_join_all_entities">${wf:conf('resumeFrom') eq 'fork_join_all_entities'}</case>
            <case to="create_payloads">${wf:conf('resumeFrom') eq 'create_payloads'}</case>
            <case to="drop_solr_collection">${wf:conf('resumeFrom') eq 'drop_solr_collection'}</case>
            <case to="to_solr_index">${wf:conf('resumeFrom') eq 'to_solr_index'}</case>
            <case to="update_solr_aliases">${wf:conf('resumeFrom') eq 'update_solr_aliases'}</case>
            <default to="prepare_relations"/>
        </switch>
    </decision>

    <kill name="Kill">
        <message>Action failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>

    <action name="prepare_relations">
        <spark xmlns="uri:oozie:spark-action:0.2">
            <master>yarn</master>
            <mode>cluster</mode>
            <name>PrepareRelations</name>
            <class>eu.dnetlib.dhp.oa.provision.PrepareRelationsJob</class>
            <jar>dhp-graph-provision-${projectVersion}.jar</jar>
            <spark-opts>
                ${sparkClusterOpts}
                ${sparkResourceOpts}
                --conf spark.sql.shuffle.partitions=15000
            </spark-opts>
            <arg>--inputType</arg><arg>${inputType}</arg>
            <arg>--inputGraph</arg><arg>${inputGraph}</arg>
            <arg>--outputPath</arg><arg>${workingDir}/relation</arg>
            <arg>--sourceMaxRelations</arg><arg>${sourceMaxRelations}</arg>
            <arg>--targetMaxRelations</arg><arg>${targetMaxRelations}</arg>
            <arg>--relationFilter</arg><arg>${relationFilter}</arg>
            <arg>--relPartitions</arg><arg>15000</arg>
            <arg>--hiveMetastoreUris</arg><arg>${hiveMetastoreUris}</arg>
        </spark>
        <ok to="fork_join_related_entities"/>
        <error to="Kill"/>
    </action>

    <fork name="fork_join_related_entities">
        <path start="join_relation_publication"/>
        <path start="join_relation_dataset"/>
        <path start="join_relation_otherresearchproduct"/>
        <path start="join_relation_software"/>
        <path start="join_relation_datasource"/>
        <path start="join_relation_organization"/>
        <path start="join_relation_project"/>
        <path start="join_relation_person"/>
    </fork>

