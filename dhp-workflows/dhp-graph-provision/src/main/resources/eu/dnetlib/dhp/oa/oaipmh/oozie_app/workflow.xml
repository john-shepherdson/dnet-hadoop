<workflow-app name="irish-oaipmh-provision" xmlns="uri:oozie:workflow:0.5">

    <parameters>
        <property>
            <name>inputPath</name>
            <description>The path of the input records on HDFS</description>
        </property>
        <property>
            <name>numConnections</name>
            <description>number of connections to the postgres db (for the write operation)</description>
        </property>
        <property>
            <name>dbUrl</name>
            <description>the url of the database</description>
        </property>
        <property>
            <name>dbUser</name>
            <description>the user of the database</description>
        </property>
        <property>
            <name>dbPwd</name>
            <description>the password for the user of the database</description>
        </property>

        <property>
            <name>sparkClusterOpts</name>
            <value>--conf spark.extraListeners= --conf spark.sql.queryExecutionListeners= --conf spark.yarn.historyServer.address=http://iis-cdh5-test-gw.ocean.icm.edu.pl:18089 --conf spark.executorEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.yarn.appMasterEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.yarn.appMasterEnv.HADOOP_USER_NAME=dnet.beta --conf spark.sql.warehouse.dir=/user/hive/warehouse --conf spark.oozie.action.sharelib.for.spark=spark344 --conf spark.eventLog.compression.codec=lz4 --conf spark.shuffle.mapStatus.compression.codec=lz4 --conf spark.shuffle.useOldFetchProtocol=true --conf spark.network.maxRemoteBlockSizeFetchToMem=1G --conf spark.eventLog.enabled=true --conf spark.eventLog.dir=hdfs://nameservice1/user/spark/spark2ApplicationHistory</value>
            <description>spark cluster-wide options</description>
        </property>
        <property>
            <name>sparkResourceOpts</name>
            <value>--executor-memory=8G --conf spark.executor.memoryOverhead=6G --executor-cores=4 --driver-memory=9G --driver-cores=4 --conf spark.default.parallelism=3840 --conf spark.sql.shuffle.partitions=7680 --conf spark.sql.files.maxPartitionBytes=33554432 --conf spark.sql.adaptive.advisoryPartitionSizeInBytes=32m --conf spark.sql.adaptive.coalescePartitions.parallelismFirst=false --conf spark.sql.adaptive.forceOptimizeSkewedJoin=true --conf spark.sql.adaptive.skewJoin.skewedPartitionThresholdInBytes=64m --conf spark.sql.adaptive.skewJoin.skewedPartitionFactor=3.0 --conf spark.executor.extraJavaOptions="-XX:MaxDirectMemorySize=4g" --conf spark.sql.parquet.enableVectorizedReader=false --conf spark.kryoserializer.buffer.max=128m</value>
            <description>spark resource options</description>
        </property>
    </parameters>

    <global>
        <job-tracker>${jobTracker}</job-tracker>
        <name-node>${nameNode}</name-node>
        <configuration>
            <property>
                <name>oozie.action.sharelib.for.spark</name>
                <value>spark344</value>
            </property>
        </configuration>
    </global>

    <start to="irish_oaiphm_provision"/>

    <kill name="Kill">
        <message>Action failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>

    <action name="irish_oaiphm_provision">
        <spark xmlns="uri:oozie:spark-action:0.2">
            <master>yarn</master>
            <mode>cluster</mode>
            <name>Irish OAI-PHM provision</name>
            <class>eu.dnetlib.dhp.oa.oaipmh.IrishOaiExporterJob</class>
            <jar>dhp-graph-provision-${projectVersion}.jar</jar>
            <spark-opts>
                ${sparkClusterOpts}
                ${sparkResourceOpts}
                --conf spark.sql.shuffle.partitions=8000
            </spark-opts>
            <arg>--inputPath</arg><arg>${inputPath}</arg>
            <arg>--numConnections</arg><arg>${numConnections}</arg>
            <arg>--dbUrl</arg><arg>${dbUrl}</arg>
            <arg>--dbUser</arg><arg>${dbUser}</arg>
            <arg>--dbPwd</arg><arg>${dbPwd}</arg>
        </spark>
        <ok to="End"/>
        <error to="Kill"/>
    </action>

    <end name="End"/>
</workflow-app>