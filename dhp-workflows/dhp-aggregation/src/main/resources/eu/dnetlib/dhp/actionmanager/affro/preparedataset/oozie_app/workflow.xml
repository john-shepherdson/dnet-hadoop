<workflow-app name="OpenAIREAffiliations" xmlns="uri:oozie:workflow:0.5">
    <parameters>
        <property>
            <name>oalexPath</name>
            <value>/data/openalex-snapshot/data/works/</value>
            <description>the path for the oalex snapshot</description>
        </property>
        <property>
            <name>oairePath</name>
            <value>/tmp/prod_provision/graph/01_graph_raw</value>
            <description>the path for the OpenAIRE graph from whcich to get the raw_affiliation_strings</description>
        </property>
        <property>
            <name>publishersPath</name>
            <description>the path where to find the information extracted from the publishers file</description>
        </property>
        <property>
            <name>datasetPath</name>
            <description>the path where to store the raw affiliation strings affiliations</description>
        </property>
        <property>
            <name>oldMatches</name>
            <description>the path the already matched affiliations are stored</description>
        </property>
        <property>
            <name>applyOnAll</name>
            <description>true if the whole set of affiliations should be used</description>
        </property>

        <!-- General oozie workflow properties -->
        <property>
            <name>sparkClusterOpts</name>
            <value>--conf spark.extraListeners= --conf spark.sql.queryExecutionListeners= --conf spark.yarn.historyServer.address=http://iis-cdh5-test-gw.ocean.icm.edu.pl:18089 --conf spark.eventLog.dir=hdfs://nameservice1/user/spark/spark2ApplicationHistory --conf spark.executorEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.yarn.appMasterEnv.JAVA_HOME=/srv/java/openjdk-17 --conf spark.sql.warehouse.dir=/user/hive/warehouse --conf spark.oozie.action.sharelib.for.spark=spark342 --conf spark.eventLog.compression.codec=lz4 --conf spark.shuffle.mapStatus.compression.codec=lz4 --conf spark.shuffle.useOldFetchProtocol=true --conf spark.eventLog.enabled=true</value>
            <description>spark cluster-wide options</description>
        </property>
        <property>
            <name>sparkResourceOpts</name>
            <value>--executor-memory=8G --conf spark.executor.memoryOverhead=4G --executor-cores=6 --driver-memory=9G --driver-cores=4 --conf spark.default.parallelism=3840 --conf spark.sql.shuffle.partitions=7680 --conf spark.sql.files.maxPartitionBytes=33554432 --conf spark.sql.adaptive.advisoryPartitionSizeInBytes=32m --conf spark.sql.adaptive.coalescePartitions.parallelismFirst=false --conf spark.sql.adaptive.forceOptimizeSkewedJoin=true --conf spark.sql.adaptive.skewJoin.skewedPartitionThresholdInBytes=64m --conf spark.sql.adaptive.skewJoin.skewedPartitionFactor=3.0 --conf spark.executor.extraJavaOptions="-XX:MaxDirectMemorySize=4g"</value>
            <description>spark resource options</description>
        </property>
        <property>
            <name>sparkApplicationOpts</name>
            <value>--conf spark.sql.shuffle.partitions=7680</value>
            <description>spark resource options</description>
        </property>
    </parameters>

    <global>
        <job-tracker>${jobTracker}</job-tracker>
        <name-node>${nameNode}</name-node>
        <configuration>
            <property>
                <name>oozie.action.sharelib.for.spark</name>
                <value>spark344</value>
            </property>
        </configuration>
    </global>

    <start to="deleteoutputpath"/>
    <kill name="Kill">
        <message>Action failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>
    <action name="deleteoutputpath">
        <fs>
            <delete path="${outputPath}"/>
            <mkdir path="${outputPath}"/>
            <delete path="${workingDir}"/>
            <mkdir path="${workingDir}"/>
        </fs>
        <ok to="preparedataset"/>
        <error to="Kill"/>
    </action>

    <action name="preparedataset">
        <spark xmlns="uri:oozie:spark-action:0.2">
            <master>yarn</master>
            <mode>cluster</mode>
            <name>Prepares the dataset to be used by affro</name>
            <class>eu.dnetlib.dhp.actionmanager.affro.PrepareDataset</class>
            <jar>dhp-aggregation-${projectVersion}.jar</jar>
            <spark-opts>
                ${sparkClusterOpts}
                ${sparkResourceOpts}
                ${sparkApplicationOpts}
            </spark-opts>
            <arg>--oalexPath</arg><arg>${oalexPath}</arg>
            <arg>--oairePath</arg><arg>${oairePath}</arg>
            <arg>--publishersPath</arg><arg>${publishersPath}</arg>
            <arg>--oldMatches</arg><arg>${oldMatches}</arg>
            <arg>--applyOnAll</arg><arg>${applyOnAll}</arg>
            <arg>--outputPath</arg><arg>${datasetPath}</arg>
            <arg>--workingDir</arg><arg>${workingDir}</arg>
            <arg>--hiveMetastoreUris</arg><arg>${hiveMetastoreUris}</arg>
        </spark>
        <ok to="run-affro"/>
        <error to="Kill"/>
    </action>

    <!-- Questo da cambiare e da usare il codice in dhf-affiliation-matching project-->
    <action name="run-affro">
        <spark xmlns="uri:oozie:spark-action:0.2">

            <master>yarn</master>
            <mode>cluster</mode>
            <name>Affiliations inference (Affro)</name>
            <jar>dataset.py</jar>

            <spark-opts>
                ${sparkClusterOpts}
                ${sparkResourceOpts}
                ${sparkApplicationOpts}
                --executor-cores=5
                --executor-memory=7G
                --driver-memory=4G
                --conf spark.dynamicAllocation.maxExecutors=27
                --conf spark.executor.memoryOverhead=7G
                --conf spark.sql.shuffle.partitions=20000
                --conf spark.yarn.appMasterEnv.PYSPARK_PYTHON=python3
                --conf spark.executorEnv.PYSPARK_PYTHON=python3
                --py-files ${wfAppPath}/affRo/affro_cluster.py,${wfAppPath}/affRo/create_input_cluster.py,${wfAppPath}/affRo/functions_cluster.py,${wfAppPath}/affRo/matching_cluster.py,${wfAppPath}/affRo/schemas.py,${wfAppPath}/affRo/utils.py
                --files ${wfAppPath}/affRo/dictionaries/dix_city_oaire.json,${wfAppPath}/affRo/dictionaries/dix_id_country_oaire.json,${wfAppPath}/affRo/dictionaries/dix_country_legalnames.json,${wfAppPath}/affRo/dictionaries/replacements.json,${wfAppPath}/affRo/dictionaries/dix_acad.json,${wfAppPath}/affRo/dictionaries/dix_acad_oaire.json,${wfAppPath}/affRo/dictionaries/dix_categ.json,${wfAppPath}/affRo/dictionaries/dix_city.json,${wfAppPath}/affRo/dictionaries/dix_country.json,${wfAppPath}/affRo/dictionaries/dix_country_oaire.json,${wfAppPath}/affRo/dictionaries/dix_grids_rors.json,,${wfAppPath}/affRo/dictionaries/dix_id_country.json,${wfAppPath}/affRo/dictionaries/dix_mult.json,${wfAppPath}/affRo/dictionaries/dix_mult_oaire.json,${wfAppPath}/affRo/dictionaries/dix_status.json,${wfAppPath}/affRo/txt_files/city_names.txt,${wfAppPath}/affRo/txt_files/remove_list.txt,${wfAppPath}/affRo/txt_files/country_names.txt,${wfAppPath}/affRo/txt_files/stop_words.txt,${wfAppPath}/affRo/txt_files/university_terms.txt
            </spark-opts>

            <arg>${outputPath}</arg>
            <arg>${outputFolder}</arg>

            <file>${wfAppPath}/affRo/dataset.py#dataset.py</file>
        </spark>

        <ok to="End" />
        <error to="Kill" />

    </action>

    <action name="redistributerelations">
        <spark xmlns="uri:oozie:spark-action:0.2">
            <master>yarn</master>
            <mode>cluster</mode>
            <name>Associate to the result and authors the affiliation links</name>
            <class>eu.dnetlib.dhp.actionmanager.affro.PrepareDataset</class>
            <jar>dhp-aggregation-${projectVersion}.jar</jar>
            <spark-opts>
                ${sparkClusterOpts}
                ${sparkResourceOpts}
                ${sparkApplicationOpts}
            </spark-opts>
            <arg>--oalexPath</arg><arg>${oalexPath}</arg>
            <arg>--oairePath</arg><arg>${oairePath}</arg>
            <arg>--publishersPath</arg><arg>${publishersPath}</arg>
            <arg>--oldMatches</arg><arg>${oldMatches}</arg>
            <arg>--applyOnAll</arg><arg>${applyOnAll}</arg>
            <arg>--outputPath</arg><arg>${datasetPath}</arg>
            <arg>--workingDir</arg><arg>${workingDir}</arg>
            <arg>--hiveMetastoreUris</arg><arg>${hiveMetastoreUris}</arg>
        </spark>
        <ok to="run-affro"/>
        <error to="Kill"/>
    </action>

    <end name="End"/>
</workflow-app>