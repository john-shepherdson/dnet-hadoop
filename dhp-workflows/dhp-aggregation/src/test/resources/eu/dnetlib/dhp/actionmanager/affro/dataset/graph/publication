demostrado su insuficiencia para definir este fenómeno, si bien la teoría de la inadecuación relevante de Attardo (2000) y el modelo de análisis pragmalingüístico de Haverkate (1985) se han identificado como potencialmente válidos para explicar cómo se reconoce e interpreta la ironía, respectivamente. Aquí presentamos los resultados más significativos obtenidos tras confrontar dichas teorías con las muestras de un corpus oral de ironías en español elaborado por nosotros. El análisis nos ha permitido corroborar la idoneidad de sus fundamentos, además de plantear nuevos supuestos acerca de qué tipo de informaciones contextuales activan el reconocimiento y qué otros modos de interpretación del enunciado irónico pueden darse aparte del prototípico consistente en una contrariedad de sentido."}],"eoscifguidelines":[],"externalReference":[],"extraInfo":[],"format":[{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"application/pdf"}],"fulltext":[{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"https://recyt.fecyt.es/index.php/pragma/article/download/95463/69250"}],"id":"50|1287497f2a65::1e71f402a07e6607a6012353d43202d4","instance":[{"accessright":{"classid":"OPEN","classname":"Open Access","openAccessRoute":"gold","schemeid":"dnet:access_modes","schemename":"dnet:access_modes"},"alternateIdentifier":[],"collectedfrom":{"key":"10|openaire____::b6c34852e0c557f6e9319fc7913d0b1d","value":"Repositorio Español de Ciencia y Tecnologí­a"},"dateofacceptance":{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysi