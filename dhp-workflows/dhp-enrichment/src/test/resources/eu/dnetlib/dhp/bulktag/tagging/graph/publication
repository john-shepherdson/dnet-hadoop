{"author":[{"fullname":"Cuadra Montoya, Ximena","name":"Ximena","pid":[],"rank":1,"surname":"Cuadra Montoya"}],"bestaccessright":{"classid":"OPEN","classname":"Open Access","schemeid":"dnet:access_modes","schemename":"dnet:access_modes"},"collectedfrom":[{"key":"10|openaire____::b6c34852e0c557f6e9319fc7913d0b1d","value":"Repositorio Español de Ciencia y Tecnologí­a"}],"context":[],"contributor":[],"country":[],"coverage":[],"dataInfo":{"deletedbyinference":true,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"dateofacceptance":{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"0001-12-30"},"dateofcollection":"2025-10-01T20:32:16+0000","dateoftransformation":"2025-10-01T20:52:33+0000","description":[{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"Revista CIDOB d’Afers Internacionals, nº 105 Cuatrimestral (enero-abril 2014) ISSN:1133-6595 | E-ISSN:2013-035X El presente artículo analiza la emergencia del activismo transnacional en la trayectoria de la acción colectiva desarrolla­da en torno a conflictos socioambientales en territorios indígenas en Chile. Se identifican los principales eventos de la movilización indígena realizada a escala internacional en tres casos emblemáticos y se distinguen las implicancias para la esfera política nacional. Se constata que, tras el bloqueo nacional a sus demandas, los indígenas se movilizan en el exterior. Allí difunden sus casos y deman­dan justicia en diversos organismos interna­cionales. Finalmente, en el ámbito local, se identifica la incorporación de marcos globa­les en torno a los derechos humanos de los pueblos indígenas."}],"eoscifguidelines":[],"externalReference":[],"extraInfo":[],"format":[{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"application/pdf"}],"fulltext":[{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"https://recyt.fecyt.es/index.php/cidob/article/download/107063/78020"}],"id":"50|1287497f2a65::2442a076f0c4334f78caacf764073c25","instance":[{"accessright":{"classid":"OPEN","classname":"Open Access","openAccessRoute":"gold","schemeid":"dnet:access_modes","schemename":"dnet:access_modes"},"alternateIdentifier":[],"collectedfrom":{"key":"10|openaire____::b6c34852e0c557f6e9319fc7913d0b1d","value":"Repositorio Español de Ciencia y Tecnologí­a"},"dateofacceptance":{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"0001-12-30"},"distributionlocation":"","fulltext":"https://recyt.fecyt.es/index.php/cidob/article/download/107063/78020","hostedby":{"key":"10|doajarticles::06e4d91fb4bd694e5be7191fabf2a622","value":"Revista CIDOB d'Afers Internacionals"},"instanceTypeMapping":[{"originalType":"research-article","typeCode":"http://purl.org/coar/resource_type/c_2df8fbb1","typeLabel":"research article","vocabularyName":"openaire::coar_resource_types_3_1"},{"originalType":"http://purl.o