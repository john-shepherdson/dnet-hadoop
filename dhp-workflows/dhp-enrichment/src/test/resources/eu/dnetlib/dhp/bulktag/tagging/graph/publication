ite of Mačkara deposit approving the earlier assumption that the Saski Rad vein deposit represents the brocken part of the Mačkara ore vein. Strong negative δ34SVCDT values in the tetrahedrites of the Saski Rad and Mačkara deposits point to their origin in post-Variscan mineralisation phase."}],"eoscifguidelines":[],"externalReference":[],"extraInfo":[],"format":[],"fulltext":[],"id":"50|57a035e5b1ae::1cbde61723ab0e291d129395c08f4a5a","instance":[{"accessright":{"classid":"CLOSED","classname":"Closed Access","schemeid":"dnet:access_modes","schemename":"dnet:access_modes"},"alternateIdentifier":[],"collectedfrom":{"key":"10|openaire____::345c9d171ef3c5d706d08041d506428c","value":"Croatian Scientific Bibliography - CROSBI"},"dateofacceptance":{"dataInfo":{"deletedbyinference":false,"inferred":false,"invisible":false,"provenanceaction":{"classid":"sysimport:crosswalk:repository","classname":"Harvested","schemeid":"dnet:provenanceActions","schemename":"dnet:provenanceActions"},"trust":"0.9"},"value":"2010-01-01"},"hostedby":{"key":"10|openaire____::345c9d171ef3c5d706d08041d506428c","value":"Croatian Scientific Bibliography - CROSBI"},"instanceTypeMapping":[{"originalType":"http://purl.org/coar/resource_type/c_6670","typeCode":"http://purl.org/coar/resource_type/c_6670","typeLabel":"conference poster","vocabularyName":"openaire::coar_resource_types_3_1"}],"instancetype":{"classid":"0004","classname":"Conference object","schemeid":"dnet:publication_resource","schemename":"dnet:publication_resource"},"measures":[],"pid":[],"refereed":{"classid":"0002","classname":"nonPeerReviewed","schemeid":"dnet:review_levels","schemename":"dnet:review_levels"},"url":["https://www.bib.irb.hr/533356"]}],"isGreen":false,"isInDiamondJournal":false,"language":{"classid":"eng","classname":"English","schemeid":"dnet:languages","schemename":"dnet:languages"},"lastupdatetimestamp":1760439181434,"measures":[{"id":"influence","unit":[{"dataInfo":{"deletedbyinference":false,"inferenceprovenance":"u